{
  "manifest_version": 3,
  "name": "KepiTAB Manager",
  "version": "1.1.7",
  "description": "A simple tab management tool",
  "browser_specific_settings": {
    "gecko": {
      "id": "kepi@addon"
    }
  },
  "icons": {
    "48": "kepi-tab-manager.png"
  },
  "permissions": [
    "tabs",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "KepiTAB Manager",
    "default_icon": "kepi-tab-manager.png"
  }
}
