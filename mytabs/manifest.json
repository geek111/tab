{
  "manifest_version": 3,
  "name": "KepiTAB Manager",
  "version": "1.1.8",
  "browser_specific_settings": {
    "gecko": { "id": "kepi@addon" }
  },
  "description": "A simple tab management tool",
  "icons": {
    "48": "kepi-tab-manager.png"
  },
  "permissions": [
    "tabs",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "KepiTAB Manager"
  }
}
